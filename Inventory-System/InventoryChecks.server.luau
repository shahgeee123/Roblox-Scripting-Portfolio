--!strict
local Inventory = require(script.Parent.InventoryService)
local bag = Inventory.new()
assert(Inventory.add(bag, "Wood", 400))
assert(not Inventory.add(bag, "Gear", 1))
assert(bag.Gear == nil and bag.Wood == 400)
assert(not Inventory.remove(bag, "Wood", 401))
assert(bag.Wood == 400)
assert(Inventory.remove(bag, "Wood", 50))
assert(Inventory.add(bag, "Gear", 10))
assert(not Inventory.add(bag, "Gear", 1))
assert(not Inventory.add(bag, "Wood", 0 / 0))
assert(not Inventory.add(bag, "Unknown", 1))
local copy = Inventory.snapshot(bag)
copy.Wood = 0
assert(bag.Wood == 350)
assert(Inventory.remove(bag, "Gear", 10))
assert(bag.Gear == nil)
print("Inventory checks passed")
